{
  "name": "coffee-and-quiet-resort",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/db/*.test.ts",
    "db:local": "node scripts/local-postgres.mjs start",
    "db:stop": "node scripts/local-postgres.mjs stop",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:http": "node --env-file=.env.local tests/http/booking.mjs",
    "test:signup": "node --env-file=.env.local tests/http/signup.mjs",
    "test:enquiries": "node --env-file=.env.local tests/http/enquiries.mjs",
    "test:browser": "node tests/browser/journeys.mjs",
    "test:ai": "tsx scripts/evaluate-ai.ts",
    "seed:enquiries": "node scripts/seed-enquiries.mjs",
    "ai:start": "node scripts/start-ai.mjs",
    "test:browser-review": "node tests/browser/review.mjs",
    "test:browser-ai": "node tests/browser/ai.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.5",
    "nodemailer": "^10.4.0",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.187.0",
    "prettier": "^3.9.10",
    "supabase": "3.0.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
